{
  "name": "dsh-plugin-mcp-apps",
  "version": "0.9.1",
  "description": "MCP-подключения: панель управления MCP-серверами (HTTP/SSE/stdio, авторизация токеном или OAuth 2.0, импорт servers.json). Форк dsh-plugin-mcp-apps с модульной локализацией: ru, en, zh.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "icon.svg",
    "docs",
    "locale",
    "cordis.patch.yml",
    "lib/auth.js",
    "lib/client.js",
    "lib/index.js",
    "lib/locales.js",
    "lib/oauth.js",
    "lib/tool-access.js",
    "src/client.js",
    "src/i18n.js",
    "src/styles.css",
    "src/ui.js",
    "scripts/build-client.mjs",
    "scripts/check-artifacts.mjs",
    "scripts/check-tool-access.mjs",
    "scripts/check-i18n.mjs",
    "scripts/install-remote.sh"
  ],
  "license": "MIT",
  "author": "Vertudo",
  "contributors": [
    "xiaoqin422 (upstream author of dsh-plugin-mcp-apps)"
  ],
  "keywords": [
    "connector",
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-apps",
    "mcp-client",
    "oauth",
    "workbench"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run i18n:check && node scripts/check-tool-access.mjs && npm run build && node scripts/check-artifacts.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@modelcontextprotocol/client": "^2.2.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertudo/dsh-plugin-mcp-apps.git"
  },
  "homepage": "https://github.com/Vertudo/dsh-plugin-mcp-apps#readme",
  "bugs": {
    "url": "https://github.com/Vertudo/dsh-plugin-mcp-apps/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
